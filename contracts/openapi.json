          "length_mm": {
            "type": "integer",
            "maximum": 1000000.0,
            "exclusiveMinimum": 0.0,
            "title": "Length Mm"
          },
          "width_mm": {
            "type": "integer",
            "maximum": 1000000.0,
            "exclusiveMinimum": 0.0,
            "title": "Width Mm"
          },
          "height_mm": {
            "type": "integer",
            "maximum": 1000000.0,
            "exclusiveMinimum": 0.0,
            "title": "Height Mm"
          },
          "mass_g": {
            "type": "integer",
            "maximum": 1000000000000.0,
            "exclusiveMinimum": 0.0,
            "title": "Mass G"
          },
          "dimensions_um": {
            "anyOf": [
              {
                "prefixItems": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "integer"
                  },
                  {
                    "type": "integer"
                  }
                ],
                "type": "array",
                "maxItems": 3,
                "minItems": 3
              },
              {
                "type": "null"
              }
            ],
            "title": "Dimensions Um"
          },
          "source_ref": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PipeSourceRef"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name",
          "kind",
          "requirement",
          "length_mm",
          "width_mm",
          "height_mm",
          "mass_g"
        ],
        "title": "CargoUnit"
      },
